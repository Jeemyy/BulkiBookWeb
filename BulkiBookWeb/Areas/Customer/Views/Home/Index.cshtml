@model IEnumerable<Product>
<!-- Hero Section --> 
<partial name="_Hero" />

<!-- Catalog Section -->
    <section class="catalog-section container py-5" id="catalog">
        <div class="mb-4">
            <span class="section-eyebrow">YOUR NEXT GREAT READ</span>
            <h2 class="fw-bold">Our Collection</h2>
            <p class="text-secondary">
                Explore our selection of books and find your next favorite.
            </p>
        </div>
    @if (Model.Any())
    {
        
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">

            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card book-card h-100">

                        <a href="#catalog" class="book-image-link">
                            <div class="book-image-wrapper">
                                <div class="book-placeholder">
                                    <img src="@product.ImageUrl" alt="Alternate Text" style="width: 100%;height: 100%;object-fit: contain;"/>
                                </div>
                            </div>
                        </a>

                        <div class="card-body d-flex flex-column p-3">

                            <span class="category-label mb-2">
                                Fiction
                            </span>

                            <h5 class="book-title">
                                @product.Title
                            </h5>

                            <p class="book-author text-secondary">
                                <i class="bi bi-person me-1"></i>
                                @product.Author
                            </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <div class="book-pricing">
                                    <span class="current-price">$@product.Price.ToString("0.00")</span>
                                    <span class="old-price">$@product.ListPrice.ToString("0.00")</span>
                                </div>

                                <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" class="btn btn-view">
                                    <i class="bi bi-arrow-up-right"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
    </div>
    }
    </section>


<partial name="_NewsLetter"/>
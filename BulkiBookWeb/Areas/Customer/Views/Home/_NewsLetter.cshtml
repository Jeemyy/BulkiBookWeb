<!-- Newsletter Section -->
    <section class="newsletter-section" id="newsletter">
        <div>
            <div class="newsletter-card text-center text-white">

                <i class="bi bi-envelope-heart newsletter-icon"></i>

                <h2 class="fw-bold mt-3">Stay Updated</h2>

                <p class="newsletter-description mx-auto mt-3">
                    Subscribe to get special offers, free giveaways,
                    and exclusive deals.
                </p>

                <form class="newsletter-form mx-auto mt-4"
                      onsubmit="return false;">

                    <div class="input-group input-group-lg">
                        <input type="email"
                               class="form-control"
                               placeholder="Your email address"
                               aria-label="Your email address"
                               required />

                        <button type="submit" class="btn btn-accent px-4">
                            Subscribe
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>

                </form>

                <p class="small text-white-50 mt-3 mb-0">
                    <i class="bi bi-shield-check me-1"></i>
                    We respect your privacy.
                </p>

            </div>
        </div>
    </section>

<!-- Hero Section -->
<section class="book-hero position-relative overflow-hidden">
    <div class="container py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 text-center text-lg-start">
                <span class="hero-label mb-3 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-stars"></i>
                    Discover your next favorite
                </span>

                <h1 class="display-3 fw-bold hero-title mb-4">
                    Every book opens
                    <span>a new world.</span>
                </h1>

                <p class="hero-description mb-4">
                    Explore our collection of books, discover new authors,
                    and find your next great read at a price you'll love.
                </p>

                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a href="#catalog" class="btn btn-accent btn-lg px-4">
                        Explore Collection
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                    <a href="#newsletter" class="btn btn-outline-light btn-lg px-4">
                        Stay Updated
                    </a>
                </div>

                <div class="hero-stats d-flex flex-wrap gap-4 mt-5 justify-content-center justify-content-lg-start">
                    <div>
                        <h4 class="fw-bold mb-0">Read</h4>
                        <small>Discover more</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Explore</h4>
                        <small>New perspectives</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Enjoy</h4>
                        <small>Better reading</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-books mx-auto position-relative">
                    <div class="hero-book hero-book-back">
                        <div class="book-placeholder book-cover-secondary">
                            <i class="bi bi-book"></i>
                        </div>
                    </div>

                    <div class="hero-book hero-book-front">
                        <div class="book-placeholder book-cover-primary">
                            <i class="bi bi-journal-bookmark"></i>
                            <span>YOUR NEXT CHAPTER</span>
                        </div>
                    </div>

                    <div class="saving-badge">
                        <small>GREAT READS</small>
                        <strong>Great value</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="hero-wave" aria-hidden="true">
        <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
            <path d="M0,35 Q360,0 720,35 T1440,20 L1440,60 L0,60 Z"
                  fill="#f5f5f5" />
        </svg>
    </div>
</section>
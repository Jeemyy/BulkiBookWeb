@using BulkyBook.Models.ModelViews
@model ProductVM

<div class="container-fluid">
    <div class="card border shadow-sm overflow-hidden">

        <!-- Card Header -->
        <div class="card-header text-white py-3 px-4"
             style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <div>
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-grid me-2"></i>
                    Add New Product
                </h5>

                <p class="mb-0 small" style="color: #1DB954;">
                    Create a new product Product
                </p>
            </div>
        </div>

        <!-- Form -->
        <div class="card-body p-4">

            <form method="post" asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="row g-4">

                    <!-- Product Product.Title -->
                    <div class="col-md-8">
                        <label class="form-label fw-semibold" asp-for="Product.Title"></label>

                        <input asp-for="Product.Title"
                            class="form-control" placeholder="Enter Product Product.Title" />

                        <span asp-validation-for="Product.Title" class="text-danger small">
                        </span>
                    </div>

                    <!-- Product.ISBN -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" asp-for="Product.ISBN"></label>

                        <input asp-for="Product.ISBN"
                               class="form-control" placeholder="Enter Product ISBN" />

                        <span asp-validation-for="Product.ISBN" class="text-danger small">
                        </span>
                    </div>
                    </div>
                <div class="row g-4">

                    <!-- Product.Description -->
                    <div class="col-md-8 pt-2">
                        <label class="form-label fw-semibold" asp-for="Product.Description"></label>

                        <textarea asp-for="Product.Description"
                                  class="form-control" placeholder="Enter Product Description">
                                  </textarea>


                        <span asp-validation-for="Product.Description" class="text-danger small">
                        </span>
                    </div>

                    <!-- Product.Author -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" asp-for="Product.Author"></label>

                        <input asp-for="Product.Author"
                               class="form-control" placeholder="Enter Product Author" />

                        <span asp-validation-for="Product.Author" class="text-danger small">
                        </span>
                    </div>
                </div>
                <div class="border rounded p-3 mt-3 bg-light">

                <div class="row g-3">
                        <!-- Product.ListProduct.Price -->
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold" asp-for="Product.ListPrice"></label>

                            <input asp-for="Product.ListPrice"
                                      class="form-control" placeholder="Enter Product ListProduct"/>


                            <span asp-validation-for="Product.ListPrice" class="text-danger small">
                            </span>
                        </div>

                        <!-- Product.Price -->
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold" asp-for="Product.Price"></label>

                            <input asp-for="Product.Price"
                                   class="form-control" placeholder="Enter Product Product.Price" />

                            <span asp-validation-for="Product.Price" class="text-danger small">
                            </span>
                        </div>
                        <!-- Product.Price50 -->
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold" asp-for="Product.Price50"></label>

                            <input asp-for="Product.Price50"
                                   class="form-control" placeholder="Enter Product Product.Author" />

                            <span asp-validation-for="Product.Price50" class="text-danger small">
                            </span>
                        </div>

                        <!-- Product.Price100 -->
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold" asp-for="Product.Price100"></label>

                            <input asp-for="Product.Price100"
                                   class="form-control" placeholder="Enter Price" />

                            <span asp-validation-for="Product.Price100" class="text-danger small">
                            </span>
                        </div>
                </div>
			</div>

                <!-- Category -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold" asp-for="Product.CategoryId"></label>

                    <select asp-for="Product.CategoryId"    
							asp-items="@Model.CategoryList"
							class="form-control">   
                            <option disabled selected>-- Select Category --</option>
                    </select>

                    <span asp-validation-for="Product.CategoryId" class="text-danger small">
                    </span>
                </div>

				<div class="col-md-12">
                <!-- Product.ImgageUrl -->
                    <label class="form-label fw-semibold" asp-for="Product.ImageUrl"></label>
                    <div class="border border-2 border-dashed rounded p-4 text-center">
                        <i class="bi bi-could-upload fs-4 text-secondary"></i>
                        <input asp-for="Product.ImageUrl" type="file" accept="image/*" 
                               class="form-control form-control-sm mt-2" placeholder="Enter Image URL" />

                        <span asp-validation-for="Product.ImageUrl" class="text-danger small">
                        </span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel
                    </a>

                    <input type="submit"
                            class="btn text-white fw-semibold"
                            style="background-color: #065f46;">
                        <i class="bi bi-check-lg me-1"></i>
                        Create Product
                    </input>

                </div>

            </form>

        </div>

    </div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
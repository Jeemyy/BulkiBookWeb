@model RegisterVM

<div class="auth-page">
    <main class="container py-5" style="color: white;">
        <section class="auth-intro mb-4">
            <span class="auth-eyebrow">Get Started</span>
            <h1>Create Your Account</h1>
            <p>Join BulkiBook and start your journey with thousands of books.</p>
        </section>

        <div class="card auth-card register-card mx-auto shadow">
            <div class="card-body p-1 p-md-5">

                <div class="text-center mb-2">
                    <i class="bi bi-book-half auth-icon"></i>
                    <h2 class="auth-logo">Bulki<span>Book</span></h2>
                    <p class="text-secondary">Your Book Store &amp; Library</p>
                </div>

                <form method="post" asp-action="Register">
					<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">

                        <div class="col-12">
                            <label asp-for="Name" class="form-label">Full Name</label>
                            <input type="text" id="name" name="name" asp-for="Name"
                                   class="form-control" placeholder="Enter your full name"
                                   autocomplete="name">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input type="email" id="email" name="email" asp-for="Email"
                                   class="form-control" placeholder="Enter your email"
                                   autocomplete="email">
							<span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input type="password" id="password" name="password" asp-for="Password"
                                   class="form-control" placeholder="Create a password"
                                   autocomplete="new-password">
                            <span asp-validation-for="Password" class="text-danger"></span>

                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" asp-for="ConfirmPassword"
                                   class="form-control" placeholder="Confirm your password"
                                   autocomplete="new-password">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                        </div>

                        <div class="col-12">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                            <input type="text" id="phone" asp-for="PhoneNumber"
                                   class="form-control" placeholder="Enter your phone number">
							<span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="StreetAddress" class="form-label">Street Address</label>
                            <input type="text" id="streetAddress" name="streetAddress" asp-for="StreetAddress"
                                   class="form-control" placeholder="Enter your street address"
                                   autocomplete="street-address">
							<span asp-validation-for="StreetAddress" class="text-danger"></span>

                        </div>

                        <div class="col-md-4">
                            <label asp-for="City" class="form-label">City</label>
                            <input type="text" id="city" name="city" asp-for="City"
                                   class="form-control" placeholder="City"
                                   autocomplete="address-level2">
							<span asp-validation-for="City" class="text-danger"></span>

                        </div>

                        <div class="col-md-4">
                            <label asp-for="State" class="form-label">State</label>
                            <input type="text" id="state" name="state" asp-for="State"
                                   class="form-control" placeholder="State"
                                   autocomplete="address-level1">
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PostalCode" class="form-label">Postal Code</label>
                            <input type="text" id="postalCode" asp-for="PostalCode"
                                   class="form-control" placeholder="Postal Code"
                                   autocomplete="postal-code">
                            <span asp-validation-for="PostalCode" class="text-danger"></span>

                        </div>

                    </div>

                    <button type="submit" class="btn btn-auth w-100 mt-4">
                        <i class="bi bi-person-plus me-2"></i>Create Account
                    </button>

                    <p class="text-center text-secondary mt-4 mb-0">
                        Already have an account?
                        <a asp-action="Login" class="auth-link fw-semibold">Login</a>
                    </p>
                </form>

            </div>
        </div>
    </main>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
                </div>
                <div>
                    <h6>Manage Categories</h6>
                    <p>Organize your book categories</p>
                </div>
                <i class="bi bi-arrow-up-right action-arrow"></i>
            </a>

            <a href="Orders.html" class="quick-action">
                <div class="quick-action-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <h6>View Orders</h6>
                    <p>Review customer orders</p>
                </div>
                <i class="bi bi-arrow-up-right action-arrow"></i>
            </a>

            <a href="Customers.html" class="quick-action">
                <div class="quick-action-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <h6>Manage Customers</h6>
                    <p>View your customer list</p>
                </div>
                <i class="bi bi-arrow-up-right action-arrow"></i>
            </a>
        </div>

    </section>


                <div class="quick-action-icon">
                    <i class="bi bi-plus-square"></i>
                </div>
                <div>
                    <h6>Add Product</h6>
                    <p>Add a new book to your store</p>
                </div>
                <i class="bi bi-arrow-up-right action-arrow"></i>
            </a>

            <a href="Categories.html" class="quick-action">

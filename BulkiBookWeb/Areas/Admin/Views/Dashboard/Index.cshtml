@model DashboardVM

<div class="dashboard-page">

	<!-- Welcome Header -->
	<section class="dashboard-welcome">
		<div>
			<span class="welcome-label">
				<i class="bi bi-grid-1x2-fill me-2"></i>
				ADMIN OVERVIEW
			</span>
			<h2>
				Welcome back,
				@* @userManager.GetUserName(User) *@
				Admin!
			</h2>
			<p>Here's what's happening with your store today.</p>
		</div>

		<a href="Product.html" class="btn btn-add-product">
			<i class="bi bi-plus-lg me-2"></i>
			Add New Product
		</a>
	</section>

	<!-- Statistics Cards -->
	<section class="dashboard-stats">
		<a class="text-decoration-none" asp-area="Admin" asp-controller="Product" asp-action="Index">
			<div class="stat-card">
				<div class="stat-top">
					<div class="stat-icon products-icon">
						<i class="bi bi-box-seam"></i>
					</div>
					<span class="stat-badge positive">
						<i class="bi bi-arrow-up-right"></i> 12%
					</span>
				</div>
				<p class="stat-label">Total Products</p>
				<h3>@Model.TotalProducts</h3>
				<p class="stat-description">Available in your store</p>
			</div>
		</a>

		<a class="text-decoration-none" asp-area="Admin" asp-controller="Order" asp-action="Index">

			<div class="stat-card">
				<div class="stat-top">
					<div class="stat-icon orders-icon">
						<i class="bi bi-cart3"></i>
					</div>
					<span class="stat-badge positive">
						<i class="bi bi-arrow-up-right"></i> 8.4%
					</span>
				</div>
				<p class="stat-label">Total Orders</p>
				<h3>@Model.TotalOrders</h3>
				<p class="stat-description">Orders received to date</p>
			</div>
		</a>
		<a class="text-decoration-none" asp-area="Admin" asp-controller="User" asp-action="Index">

			<div class="stat-card">
				<div class="stat-top">
					<div class="stat-icon categories-icon">
						<i class="bi bi-people"></i>
					</div>
					<span class="stat-badge neutral">Active</span>
				</div>
				<p class="stat-label">Total Users</p>
				<h3>@Model.TotalUsers</h3>
				<p class="stat-description">Users Management</p>
			</div>
		</a>

		<div class="stat-card">
			<div class="stat-top">
				<div class="stat-icon revenue-icon">
					<i class="bi bi-currency-dollar"></i>
				</div>
				<span class="stat-badge positive">
					<i class="bi bi-arrow-up-right"></i> 18.2%
				</span>
			</div>
			<p class="stat-label">Total Revenue</p>
			<h3>$@Model.TotalRevenu</h3>
			<p class="stat-description">Revenue across all orders</p>
		</div>


	</section>

	<!-- Main Dashboard Grid -->
	<section class="dashboard-main-grid">

		<!-- Sales Overview -->
<!-- Sales Overview -->
<div class="dashboard-panel sales-panel">
    <div class="panel-header">
        <div>
            <h5 id="chartTitle">Revenue Overview</h5>
        </div>

        <span class="chart-period">
            <i class="bi bi-calendar3 me-2"></i>
            Last 6 months
        </span>
    </div>

    <div class="sales-summary">
        <div>
            <span class="summary-label" id="summaryLabel">Total Revenue</span>
            <h3 id="summaryValue">$0</h3>
        </div>

        <span class="sales-growth">
            <i class="bi bi-graph-up-arrow me-1"></i>
            Store Analytics
        </span>
    </div>

    <div class="chart">
        <div class="chart-bars">
            <canvas id="MonthlyRevenue"></canvas>
        </div>
    </div>
</div>


		<!-- Quick Actions -->
<div class="dashboard-panel quick-actions-panel">

    <div class="panel-header">
        <div>
            <h5>Quick Actions</h5>
            <p>Explore your store analytics</p>
        </div>

        <i class="bi bi-lightning-charge panel-heading-icon"></i>
    </div>

    <button type="button" class="quick-action active"
            data-chart="revenue">
        <div class="quick-action-icon">
            <i class="bi bi-currency-dollar"></i>
        </div>
        <div>
            <h6>Total Revenue</h6>
        </div>
        <i class="bi bi-arrow-up-right action-arrow"></i>
    </button>

    <button type="button" class="quick-action"
            data-chart="orders">
        <div class="quick-action-icon">
            <i class="bi bi-cart3"></i>
        </div>
        <div>
            <h6>Total Orders</h6>
        </div>
        <i class="bi bi-arrow-up-right action-arrow"></i>
    </button>

    <button type="button" class="quick-action"
            data-chart="status">
        <div class="quick-action-icon">
            <i class="bi bi-receipt"></i>
        </div>
        <div>
            <h6>Order Status</h6>	
        </div>
        <i class="bi bi-arrow-up-right action-arrow"></i>
    </button>

    <button type="button" class="quick-action"
            data-chart="categories">
        <div class="quick-action-icon">
            <i class="bi bi-book"></i>
        </div>
        <div>
            <h6>Products By Category</h6>
        </div>
        <i class="bi bi-arrow-up-right action-arrow"></i>
    </button>

</div>
	</section>

	<!-- Recent Orders -->
	<section class="dashboard-panel recent-orders-panel">

		<div class="panel-header">
			<div>
				<h5>Recent Orders</h5>
				<p>Latest activity from your store</p>
			</div>

			<a href="Orders.html" class="view-all-link">
				View All <i class="bi bi-arrow-right ms-1"></i>
			</a>
		</div>

		<div class="table-responsive">
			<table class="table dashboard-table align-middle mb-0">
				<thead>
					<tr>
						<th>Order ID</th>
						<th>Customer</th>
						<th>Date</th>
						<th>Amount</th>
						<th>Status</th>
						<th class="text-end">Action</th>
					</tr>
				</thead>

				<tbody>
					<tr>
						<td><span class="order-id">#ORD-1024</span></td>
						<td>
							<div class="customer-cell">
								<div class="customer-avatar">AM</div>
								<span>Ahmed Mohamed</span>
							</div>
						</td>
						<td>Oct 24, 2026</td>
						<td class="order-amount">$125.00</td>
						<td><span class="status-badge status-completed">Completed</span></td>
						<td class="text-end">
							<a href="Orders.html" class="table-action">
								<i class="bi bi-eye"></i>
							</a>
						</td>
					</tr>

					<tr>
						<td><span class="order-id">#ORD-1023</span></td>
						<td>
							<div class="customer-cell">
								<div class="customer-avatar avatar-purple">MK</div>
								<span>Mohamed Khaled</span>
							</div>
						</td>
						<td>Oct 23, 2026</td>
						<td class="order-amount">$89.50</td>
						<td><span class="status-badge status-pending">Pending</span></td>
						<td class="text-end">
							<a href="Orders.html" class="table-action">
								<i class="bi bi-eye"></i>
							</a>
						</td>
					</tr>

					<tr>
						<td><span class="order-id">#ORD-1022</span></td>
						<td>
							<div class="customer-cell">
								<div class="customer-avatar avatar-orange">SA</div>
								<span>Sara Ali</span>
							</div>
						</td>
						<td>Oct 22, 2026</td>
						<td class="order-amount">$210.00</td>
						<td><span class="status-badge status-processing">Processing</span></td>
						<td class="text-end">
							<a href="Orders.html" class="table-action">
								<i class="bi bi-eye"></i>
							</a>
						</td>
					</tr>

					<tr>
						<td><span class="order-id">#ORD-1021</span></td>
						<td>
							<div class="customer-cell">
								<div class="customer-avatar avatar-blue">YO</div>
								<span>Youssef Omar</span>
							</div>
						</td>
						<td>Oct 21, 2026</td>
						<td class="order-amount">$54.00</td>
						<td><span class="status-badge status-completed">Completed</span></td>
						<td class="text-end">
							<a href="Orders.html" class="table-action">
								<i class="bi bi-eye"></i>
							</a>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

		<div class="orders-footer">
			Showing 4 recent orders
		</div>

	</section>

</div>

@section Scripts {
	<script src="~/js/dashboard.js" asp-append-version="true"></script>
}
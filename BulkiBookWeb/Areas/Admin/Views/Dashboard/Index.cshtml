                    <div class="chart-column">
                        <div class="chart-bar" style="height: 84%;"></div>
                        <span>Sep</span>
                    </div>
                    <div class="chart-column">
                        <div class="chart-bar current" style="height: 96%;"></div>
                        <span>Oct</span>
                    </div>

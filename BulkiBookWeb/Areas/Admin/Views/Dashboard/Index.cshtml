                </span>
            </div>

            <div class="sales-summary">
                <div>
                    <span class="summary-label">Total Sales</span>
                    <h3>$18,450</h3>
                </div>
                <span class="sales-growth">
                    <i class="bi bi-graph-up-arrow me-1"></i>
                    14.6% growth
                </span>
            </div>

            <div class="chart">
                <div class="chart-grid">
                    <div class="chart-line"><span>$5k</span></div>
                    <div class="chart-line"><span>$4k</span></div>
                    <div class="chart-line"><span>$3k</span></div>
                    <div class="chart-line"><span>$2k</span></div>
                    <div class="chart-line"><span>$1k</span></div>
                </div>

                <div class="chart-bars">
                    <div class="chart-column">
                        <div class="chart-bar" style="height: 38%;"></div>
                        <span>Apr</span>
                    </div>
                    <div class="chart-column">
                        <div class="chart-bar" style="height: 54%;"></div>
                        <span>May</span>
                    </div>
                    <div class="chart-column">
                        <div class="chart-bar" style="height: 45%;"></div>

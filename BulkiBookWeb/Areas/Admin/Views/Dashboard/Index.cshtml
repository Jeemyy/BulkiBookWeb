
<div class="dashboard-page">

    <!-- Welcome Header -->
    <section class="dashboard-welcome">
        <div>
            <span class="welcome-label">
                <i class="bi bi-grid-1x2-fill me-2"></i>
                ADMIN OVERVIEW
            </span>
            <h2>Welcome back, Admin!</h2>
            <p>Here's what's happening with your store today.</p>
        </div>

        <a href="Product.html" class="btn btn-add-product">
            <i class="bi bi-plus-lg me-2"></i>
            Add New Product
        </a>
    </section>

    <!-- Statistics Cards -->
    <section class="dashboard-stats">

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon products-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <span class="stat-badge positive">
                    <i class="bi bi-arrow-up-right"></i> 12%
                </span>
            </div>
            <p class="stat-label">Total Products</p>
            <h3>248</h3>
            <p class="stat-description">Available in your store</p>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon orders-icon">
                    <i class="bi bi-cart3"></i>
                </div>
                <span class="stat-badge positive">
                    <i class="bi bi-arrow-up-right"></i> 8.4%
                </span>
            </div>
            <p class="stat-label">Total Orders</p>
            <h3>1,284</h3>
            <p class="stat-description">Orders received to date</p>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon revenue-icon">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <span class="stat-badge positive">
                    <i class="bi bi-arrow-up-right"></i> 18.2%
                </span>
            </div>
            <p class="stat-label">Total Revenue</p>
            <h3>$24,680</h3>
            <p class="stat-description">Revenue across all orders</p>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon categories-icon">
                    <i class="bi bi-collection"></i>
                </div>
                <span class="stat-badge neutral">Active</span>
            </div>
            <p class="stat-label">Categories</p>
            <h3>18</h3>
            <p class="stat-description">Organized product categories</p>
        </div>

    </section>

    <!-- Main Dashboard Grid -->
    <section class="dashboard-main-grid">

        <!-- Sales Overview -->
        <div class="dashboard-panel sales-panel">
            <div class="panel-header">
                <div>
                    <h5>Sales Overview</h5>
                    <p>Monthly sales performance</p>
                </div>

                <span class="chart-period">
                    <i class="bi bi-calendar3 me-2"></i>

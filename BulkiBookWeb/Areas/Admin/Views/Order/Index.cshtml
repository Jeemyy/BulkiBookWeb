@model List<OrderHeader>
@{
    var inactive = "btn btn-outline-secondary btn-sm";
    var active = "btn btn-sm text-white";
    var status = Context.Request.Query["status"];
    var pending = inactive;
    var inprocess = inactive;
    var shipped = inactive;
    var approved = inactive;
    var cancelled = inactive;
    var all = inactive;

    switch (status)
    {
        case "pending": pending = active; break;
        case "inprocess": inprocess = active; break;
        case "shipped": shipped = active; break;
        case "approved": approved = active; break;
        case "cancelled": cancelled = active; break;
        default: all = active; break;
    }

    var isCustomer = User.IsInRole(SD.RoleCustomer);
    var containerClass = isCustomer ? "container my-4 pt-3" : "container-fluid py-4";
}

<div class="@containerClass">
    <div class="card border shadow-sm overflow-hidden">

        <!-- Card Header -->
        <div class="card-header text-white py-3 px-4"
             style="background: linear-gradient(to right, #065f46, #282828, #191414);">

            <div>
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-grid me-2"></i>
                    Orders
                </h5>

                <p class="mb-0 small" style="color: #1DB954;">
                    Manage Orders
                </p>
            </div>
            <a asp-controller="Order"  class="btn btn-sm btn-outline-light fw-semibold d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i>
                New Order
            </a>

            <div class="d-flex flex-wrap flex-items-center gap-2">
                <span class="text-uppercase fw-semibold me-1" style="color: #1DB954; font-size: 0.875rem; letter-spacing: 0.05em;">Filter: </span>
                <a class="@all" asp-controller="Order" asp-action="Index" asp-route-status="all">All</a>
                <a class="@pending" asp-controller="Order" asp-action="Index" asp-route-status="pending">Pending</a>
                <a class="@approved" asp-controller="Order" asp-action="Index" asp-route-status="approved">Approved</a>
                <a class="@inprocess" asp-controller="Order" asp-action="Index" asp-route-status="processing">Processing</a>
                <a class="@shipped" asp-controller="Order" asp-action="Index" asp-route-status="shipped">Shipped</a>
                <a class="@cancelled" asp-controller="Order" asp-action="Index" asp-route-status="cancelled">Cancelled</a>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-styled mb-0" id="tblData">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
}
@model AdminChangePasswordVM
<div class="reset-password-page">

    <div class="reset-password-card">

        <!-- Header -->
        <div class="reset-password-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <span class="reset-password-eyebrow">ACCOUNT SECURITY</span>

        <h2>Reset Password</h2>

        <!-- Password Form -->
        <form method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
			<input hidden asp-for="UserId" />
			<input hidden asp-for="UserEmail"/>

            <!-- Email -->
            <div class="reset-form-group">
                <label for="userEmail">User Email</label>

                <div class="reset-input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input type="email"
                        asp-for="@Model.UserEmail"
                           id="userEmail"
                           class="form-control"
                           placeholder="Enter user email"
                           readonly />
                </div>
            </div>

            <!-- New Password -->
            <div class="reset-form-group">
                <label for="newPassword">New Password</label>

                <div class="reset-input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password"
                        asp-for="@Model.NewPassword"
                           id="newPassword"
                           class="form-control"
                           placeholder="Enter new password"/>
                    <span asp-validation-for="@Model.NewPassword" class="text-danger"></span>

                </div>
            </div>

            <!-- Confirm Password -->
            <div class="reset-form-group">
                <label for="confirmPassword">Confirm New Password</label>

                <div class="reset-input-wrapper">
                    <i class="bi bi-lock-fill"></i>
                    <input type="password"
                           id="confirmPassword"
                           asp-for="@Model.ConfirmPassword"
                           class="form-control"
                           placeholder="Confirm new password"
                           />
					<span asp-validation-for="@Model.ConfirmPassword" class="text-danger mb-5"></span>
                </div>
            </div>

           

            <!-- Actions -->
            <button type="submit" class="btn-reset-password">
                <i class="bi bi-check-circle me-2"></i>
                Update Password
            </button>

            <a asp-action="Index" class="btn-cancel-reset">
                Cancel
            </a>

        </form>

    </div>

</div>

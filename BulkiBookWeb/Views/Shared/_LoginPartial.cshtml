@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> userManager
@inject SignInManager<ApplicationUser> signManager

@if (signManager.IsSignedIn(User))
{
	<a class="text-white-50 text-decoration-none small fw-medium">
		<i class="bi bi-person-circle me-1"></i>
		@userManager.GetUserName(User)
	</a>
	<form method="post" asp-area="Identity" asp-controller="Account" asp-action="Logout">
		<button type="submit" class="btn btn-sm btn-outline-light" 
		style="font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase;">Logout</button>
	</form>
}
else
{
	<a class="text-white-50 text-decoration-none small fw-medium nav-link-hover"
	   asp-area="Identity"
	   asp-controller="Account"
	   asp-action="Register">Register</a>

	<a class="btn btn-sm btn-accent fw-semibold"
	   asp-area="Identity"
	   asp-controller="Account"
	   asp-action="Login">Login</a>
}
